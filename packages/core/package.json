{
  "name": "@kelvara/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:decode": "vitest run test/ingest.test.ts test/decode-*.test.ts",
    "test:rules": "vitest run test/rules-*.test.ts",
    "test:contract": "vitest run test/report-*.test.ts",
    "test:determinism": "node ../../tools/selfcheck/src/pending.mjs G9 M7",
    "fixtures:decode-spike": "node scripts/fetch-decode-spike.mjs",
    "fixtures:state": "esbuild scripts/record-state-fixtures.ts --bundle --platform=node --format=esm --log-level=warning --outfile=dist/scripts/record-state-fixtures.mjs && node dist/scripts/record-state-fixtures.mjs",
    "fixtures:rules": "esbuild scripts/record-rule-fixtures.ts --bundle --platform=node --format=esm --log-level=warning --outfile=dist/scripts/record-rule-fixtures.mjs && node dist/scripts/record-rule-fixtures.mjs",
    "fixtures:poison-history": "esbuild scripts/record-poison-history.ts --bundle --platform=node --format=esm --log-level=warning --outfile=dist/scripts/record-poison-history.mjs && node dist/scripts/record-poison-history.mjs",
    "fixtures:graph": "esbuild scripts/record-graph-fixtures.ts --bundle --platform=node --format=esm --log-level=warning --outfile=dist/scripts/record-graph-fixtures.mjs && node dist/scripts/record-graph-fixtures.mjs",
    "fixtures:analyze": "esbuild scripts/record-analyze-fixtures.ts --bundle --platform=node --format=esm --log-level=warning --outfile=dist/scripts/record-analyze-fixtures.mjs && node dist/scripts/record-analyze-fixtures.mjs",
    "test:analyze": "vitest run test/analyze.test.ts"
  },
  "dependencies": {
    "@codama/dynamic-parsers": "1.4.2",
    "@codama/nodes": "1.11.0",
    "@codama/visitors-core": "1.11.0",
    "@solana/kit": "8.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vitest": "3.2.7"
  }
}
