{
  "name": "@kelvara/scenarios",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:localnet": "node ../../tools/selfcheck/src/pending.mjs G6 M4",
    "fixtures:fetch": "node scripts/fixtures-fetch.mjs",
    "fixtures:verify": "node scripts/fixtures-verify.mjs",
    "localnet:up": "node scripts/localnet.mjs up",
    "localnet:check": "node scripts/localnet.mjs check",
    "localnet:down": "node scripts/localnet.mjs down",
    "test": "node --test test/",
    "scenario:admin-local": "node scripts/admin-local.mjs",
    "scenario:admin-local:attack": "node scripts/admin-local.mjs --attack-only",
    "test:e2e": "node scripts/e2e.mjs",
    "scenario:trap-local": "node scripts/trap-local.mjs",
    "scenario:trap-local:attack": "node scripts/trap-local.mjs --attack-only"
  }
}
