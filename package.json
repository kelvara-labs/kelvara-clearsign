{
  "name": "kelvara-signguard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --if-present build",
    "release": "node scripts/release.mjs",
    "typecheck": "pnpm -r --filter \"./packages/*\" --filter ./test-dapp typecheck",
    "lint": "eslint .",
    "test:decode": "pnpm --filter @kelvara/core test:decode",
    "test:rules": "pnpm --filter @kelvara/core test:rules",
    "test:contract": "pnpm --filter @kelvara/core test:contract",
    "test:registry": "pnpm --filter @kelvara/idls test:registry",
    "test:localnet": "pnpm --filter @kelvara/scenarios test:localnet",
    "test:e2e": "pnpm --filter @kelvara/selfcheck test:e2e",
    "test:replay": "pnpm --filter @kelvara/selfcheck test:replay",
    "test:determinism": "pnpm --filter @kelvara/core test:determinism",
    "test:security": "pnpm --filter @kelvara/selfcheck test:security",
    "idls:build": "pnpm --filter @kelvara/idls idls:build",
    "selfcheck": "node tools/selfcheck/src/run.mjs",
    "fixtures:fetch": "pnpm --filter @kelvara/scenarios fixtures:fetch",
    "fixtures:verify": "pnpm --filter @kelvara/scenarios fixtures:verify",
    "localnet:up": "pnpm --filter @kelvara/scenarios localnet:up",
    "localnet:check": "pnpm --filter @kelvara/scenarios localnet:check",
    "localnet:down": "pnpm --filter @kelvara/scenarios localnet:down",
    "scenario:admin-local": "pnpm --filter @kelvara/scenarios scenario:admin-local",
    "scenario:admin-local:attack": "pnpm --filter @kelvara/scenarios scenario:admin-local:attack",
    "scenario:trap-local": "pnpm --filter @kelvara/scenarios scenario:trap-local",
    "scenario:trap-local:attack": "pnpm --filter @kelvara/scenarios scenario:trap-local:attack",
    "scenario:e2e": "pnpm --filter @kelvara/scenarios test:e2e",
    "scenario:poison-devnet": "pnpm --filter @kelvara/scenarios scenario:poison-devnet",
    "scenario:admin-devnet": "pnpm --filter @kelvara/scenarios scenario:admin-devnet",
    "scenario:admin-devnet:attack": "pnpm --filter @kelvara/scenarios scenario:admin-devnet:attack",
    "scenario:trap-devnet": "pnpm --filter @kelvara/scenarios scenario:trap-devnet",
    "scenario:trap-devnet:attack": "pnpm --filter @kelvara/scenarios scenario:trap-devnet:attack",
    "scenario:sweep-devnet": "pnpm --filter @kelvara/scenarios scenario:sweep-devnet",
    "scenario:sweep-devnet:attack": "pnpm --filter @kelvara/scenarios scenario:sweep-devnet:attack",
    "scenario:sweep-local": "pnpm --filter @kelvara/scenarios scenario:sweep-local",
    "scenario:sweep-local:attack": "pnpm --filter @kelvara/scenarios scenario:sweep-local:attack",
    "scenario:e2e-cases": "pnpm --filter @kelvara/scenarios scenario:e2e-cases",
    "fixtures:poison": "pnpm --filter @kelvara/scenarios fixtures:poison",
    "demo:serve": "pnpm --filter @kelvara/scenarios demo:serve",
    "demo:prepare": "pnpm --filter @kelvara/scenarios demo:prepare",
    "demo:prepare-fees": "pnpm --filter @kelvara/scenarios demo:prepare-fees"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
